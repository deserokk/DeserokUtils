<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">

	<!-- No package references on purpose. XivCommon 9.0.0 (what TinyCommands pulls) predates this
	     SDK and still wants the old DalamudPluginInterface, and the only thing we needed from it
	     was a chat-line send, which is four lines of ClientStructs. One fewer dependency to break
	     on the next API bump. -->

	<PropertyGroup>
		<Product>CastWatch</Product>
		<AssemblyName>CastWatch</AssemblyName>
		<Version>1.0.0</Version>
		<Authors>deserokk</Authors>
		<Description>Gate a macro line on whether an action actually went off.</Description>
		<PackageProjectUrl>https://github.com/deserokk/CastWatch</PackageProjectUrl>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Nullable>enable</Nullable>
	</PropertyGroup>

</Project>
